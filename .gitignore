# Environment variables
.env
.env.local
.env.*.local

# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
.vite/
.vercel/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# User data (if storing locally)
user-data/
uploads/

# API keys and secrets
secrets.json
credentials.json
*.pem
*.key

# Cache
.cache/
.parcel-cache/

# Debug
debug.log

# Production source maps
*.map

# PWA generated files (keep originals)
# None - we want to keep manifest.json and sw.js

# Backup files
*.bak
*.backup

# Documentation builds
docs/build/
