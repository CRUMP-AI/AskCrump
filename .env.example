# ============================================
# CRUMP AI - ENVIRONMENT CONFIG TEMPLATE
# Copy this file to ".env" and fill in real values.
# DO NOT COMMIT YOUR REAL .env FILE.
# ============================================

# ===== CORE APP SECRETS =====

# JWT secret used for signing auth tokens
# Example: a long random string
JWT_SECRET="change-this-to-a-strong-random-secret"

# ===== SUPABASE CONFIGURATION =====

# Your Supabase project URL
# Example: https://your-project-id.supabase.co
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase anon/public key (safe for client-side use, but keep in env for simplicity)
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase service key (admin-level, server-side only)
SUPABASE_SERVICE_KEY="your-supabase-service-key"

# ===== EMAIL PROVIDER (RESEND OR SIMILAR) =====

# API key for your transactional email service
RESEND_API_KEY="your-resend-api-key"

# Optional: default from email for system messages
EMAIL_FROM_ADDRESS="Crump AI <no-reply@yourdomain.com>"

# ===== STRIPE CONFIGURATION (IF USING BILLING) =====

# Stripe secret key (starts with "sk_")
STRIPE_SECRET_KEY="sk_your_stripe_secret_key"

# Stripe webhook signing secret (from Stripe dashboard)
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Pricing or product IDs (optional, depending on your setup)
STRIPE_PRICE_ID_BASIC="price_basic_plan_id"
STRIPE_PRICE_ID_PRO="price_pro_plan_id"

# ===== EXTERNAL API KEYS FOR TOOLS (OPTIONAL BUT RECOMMENDED) =====

# Weather API key (e.g., OpenWeatherMap)
WEATHER_API_KEY="your-weather-api-key"

# News API key (for /api/news, if required)
NEWS_API_KEY="your-news-api-key"

# Movies API key (e.g., TMDB)
MOVIES_API_KEY="your-movies-api-key"

# Sports API key (if using any sports data provider)
SPORTS_API_KEY="your-sports-api-key"

# Stocks/crypto API key (for financial tools)
FINANCE_API_KEY="your-finance-api-key"

# Maps / Places API key (e.g., Google Maps)
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# YouTube Data API key (for /api/youtube)
YOUTUBE_API_KEY="your-youtube-api-key"

# ===== APP ENVIRONMENT FLAGS =====

# Node environment
NODE_ENV="development"

# Public-facing app URL (used in emails, redirects, etc.)
APP_BASE_URL="http://localhost:3000"
