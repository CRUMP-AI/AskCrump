# Core application
APP_ENV=development
APP_NAME=Ask Crump
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://askcrump.com,https://www.askcrump.com,capacitor://localhost,http://localhost
COOKIE_SECURE=false
SESSION_DAYS=365

# Supabase (server-side service role; never expose this key in the app bundle)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# AI providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_VISION_MODEL=gpt-5.6-sol
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=veo-3.1-lite-generate-preview
BRAVE_API_KEY=
OPENWEATHER_API_KEY=

# Product feature kill switches and cost guards
CRUMP_ENABLE_WEB_SEARCH=true
CRUMP_ENABLE_IMAGE_GENERATION=true
CRUMP_ENABLE_VIDEO_GENERATION=false
CRUMP_ENABLE_MANUSCRIPTS=true
MAX_ACTIVE_VIDEO_JOBS_PER_USER=1
MAX_GENERATED_VIDEO_BYTES=94371840

# Private files
CRUMP_STORAGE_BUCKET=crump-files
MAX_UPLOAD_BYTES=52428800

# Transactional email
RESEND_API_KEY=
FROM_EMAIL=Ask Crump <noreply@askcrump.com>
SUPPORT_EMAIL=support@askcrump.com

# Web subscriptions (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PROFESSIONAL_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
WEB_PROFESSIONAL_PRICE_LABEL=$20/month
WEB_ENTERPRISE_PRICE_LABEL=$50/month

# Web Crump Credits — create three one-time Stripe Prices, then place their IDs here.
STRIPE_CREDITS_50_PRICE_ID=
STRIPE_CREDITS_150_PRICE_ID=
STRIPE_CREDITS_400_PRICE_ID=
STRIPE_CREDITS_WEBHOOK_SECRET=
WEB_CREDITS_50_PRICE_LABEL=$4.99
WEB_CREDITS_150_PRICE_LABEL=$9.99
WEB_CREDITS_400_PRICE_LABEL=$19.99

# Native subscriptions + consumable Crump Credits (RevenueCat / StoreKit / Play Billing)
REVENUECAT_WEBHOOK_AUTH=Bearer REPLACE_WITH_RANDOM_SECRET
REVENUECAT_SECRET_API_KEY=
REVENUECAT_IOS_PUBLIC_SDK_KEY=
REVENUECAT_ANDROID_PUBLIC_SDK_KEY=
REVENUECAT_ENTITLEMENT=professional
REVENUECAT_PROFESSIONAL_PRODUCT_ID=askcrump_professional_monthly
REVENUECAT_ENTERPRISE_PRODUCT_ID=askcrump_enterprise_monthly
REVENUECAT_CREDITS_50_PRODUCT_ID=askcrump_credits_50
REVENUECAT_CREDITS_150_PRODUCT_ID=askcrump_credits_150
REVENUECAT_CREDITS_400_PRODUCT_ID=askcrump_credits_400

# Limits and request protection
MAX_REQUEST_BYTES=5242880
MAX_HISTORY_MESSAGES=120
MAX_HISTORY_CHARS=450000
FREE_DAILY_MESSAGES=25
PROFESSIONAL_DAILY_MESSAGES=500
ENTERPRISE_DAILY_MESSAGES=5000

# Server-side Crump Check-ins
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CHECK_IN_BATCH_SIZE=10

# Native push delivery — Android / Firebase Cloud Messaging
FCM_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Native push delivery — Apple Push Notification service
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.clevercrump.askcrump
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=sandbox
