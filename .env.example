# ==========================================
# CRUMP AI - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in your API keys
# NEVER commit .env to version control!

# ==========================================
# AI MODELS (Choose one or more)
# ==========================================

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI API (alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# ==========================================
# EXTERNAL SERVICES
# ==========================================

# Weather API
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here

# Google Services
GOOGLE_MAPS_API_KEY=your_google_maps_key_here
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret_here

# Recipe API
SPOONACULAR_API_KEY=your_spoonacular_key_here

# News API
NEWS_API_KEY=your_news_api_key_here

# Sports API
SPORTS_API_KEY=your_sports_api_key_here

# Stock Market API
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
FINNHUB_API_KEY=your_finnhub_key_here

# Movie Database API
TMDB_API_KEY=your_tmdb_key_here

# Spotify API
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# YouTube API
YOUTUBE_API_KEY=your_youtube_api_key_here

# GitHub API
GITHUB_TOKEN=your_github_token_here

# Cryptocurrency API
COINMARKETCAP_API_KEY=your_coinmarketcap_key_here

# Flight Tracking API
AVIATIONSTACK_API_KEY=your_aviationstack_key_here

# ==========================================
# IMAGE GENERATION
# ==========================================

# Stability AI (Stable Diffusion)
STABILITY_API_KEY=your_stability_api_key_here

# DALL-E (via OpenAI)
# Uses OPENAI_API_KEY above

# Replicate API (alternative)
REPLICATE_API_KEY=your_replicate_api_key_here

# ==========================================
# PAYMENT PROCESSING
# ==========================================

# Stripe
STRIPE_PUBLIC_KEY=your_stripe_public_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# ==========================================
# APPLICATION SETTINGS
# ==========================================

# Environment
NODE_ENV=development

# Base URL
BASE_URL=http://localhost:3000

# Session Settings
SESSION_SECRET=your_random_session_secret_here

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# OPTIONAL: ANALYTICS & MONITORING
# ==========================================

# Sentry (Error Tracking)
SENTRY_DSN=your_sentry_dsn_here

# Google Analytics
GA_MEASUREMENT_ID=your_ga_measurement_id_here

# PostHog (Privacy-focused analytics)
POSTHOG_API_KEY=your_posthog_key_here

# ==========================================
# DATABASE (If needed for future features)
# ==========================================

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/crump_ai

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# ==========================================
# SECURITY
# ==========================================

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# Encryption Key
ENCRYPTION_KEY=your_32_character_encryption_key

# ==========================================
# FEATURE FLAGS
# ==========================================

ENABLE_AUTONOMOUS_MODE=true
ENABLE_IMAGE_GENERATION=true
ENABLE_VOICE_MODE=false
ENABLE_ANALYTICS=false
ENABLE_RATE_LIMITING=true

# ==========================================
# NOTES
# ==========================================
# 
# Where to get API keys:
# 
# - Anthropic: https://console.anthropic.com/
# - OpenAI: https://platform.openai.com/api-keys
# - OpenWeatherMap: https://openweathermap.org/api
# - Google Cloud: https://console.cloud.google.com/
# - Spoonacular: https://spoonacular.com/food-api
# - News API: https://newsapi.org/
# - Alpha Vantage: https://www.alphavantage.co/
# - TMDB: https://www.themoviedb.org/settings/api
# - Spotify: https://developer.spotify.com/dashboard
# - GitHub: https://github.com/settings/tokens
# - Stripe: https://dashboard.stripe.com/apikeys
# 
# Most APIs offer free tiers for development!
#
