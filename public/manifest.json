  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0f1419",
  "theme_color": "#c9b892",
  "lang": "en-US",
  "dir": "ltr",
  "icons": [
    {
      "src": "/assets/images/icon-192.png",
