{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/ask-crump",
      "destination": "https://www.askcrump.com/",
      "permanent": true
    },
    {
      "source": "/clever-crump",
      "destination": "https://www.clevercrump.com/",
      "permanent": true
    },
    {
      "source": "/app",
      "has": [
        { "type": "host", "value": "www.clevercrump.com" }
      ],
      "destination": "https://www.askcrump.com/app",
      "permanent": true
    },
    {
      "source": "/ai-presentation-maker",
      "has": [
        { "type": "host", "value": "www.clevercrump.com" }
      ],
      "destination": "https://www.askcrump.com/ai-presentation-maker",
      "permanent": true
    },
    {
      "source": "/ai-document-generator",
      "has": [
        { "type": "host", "value": "www.clevercrump.com" }
      ],
      "destination": "https://www.askcrump.com/ai-document-generator",
      "permanent": true
    },
    {
      "source": "/ai-resume-builder",
      "has": [
        { "type": "host", "value": "www.clevercrump.com" }
      ],
      "destination": "https://www.askcrump.com/ai-resume-builder",
      "permanent": true
    },
    {
      "source": "/ai-video-generator",
      "has": [
        { "type": "host", "value": "www.clevercrump.com" }
      ],
      "destination": "https://www.askcrump.com/ai-video-generator",
      "permanent": true
    },
    {
      "source": "/legal",
      "has": [
        { "type": "host", "value": "www.clevercrump.com" }
      ],
      "destination": "https://www.askcrump.com/legal",
      "permanent": true
    },
    {
      "source": "/delete-account",
      "has": [
        { "type": "host", "value": "www.clevercrump.com" }
      ],
      "destination": "https://www.askcrump.com/delete-account",
      "permanent": true
    },
    {
      "source": "/robots.txt",
      "has": [
        { "type": "host", "value": "www.clevercrump.com" }
      ],
      "destination": "https://www.clevercrump.com/clever-crump-robots.txt",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "has": [
        { "type": "host", "value": "www.clevercrump.com" }
      ],
      "destination": "https://www.clevercrump.com/clever-crump-sitemap.xml",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "clevercrump.com" }
      ],
      "destination": "/clever-crump"
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "www.clevercrump.com" }
      ],
      "destination": "/clever-crump"
    },
    {
      "source": "/",
      "destination": "/ask-crump"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https://*.supabase.co https://*.storage.supabase.co; connect-src 'self' https://askcrump.com https://www.askcrump.com https://*.supabase.co https://*.storage.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/check-ins",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/manuscripts",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,docs/**,dist/**,scripts/**,*.zip,.git/**,.env}"
    }
  }
}
