{
  "name": "ask-crump",
  "version": "5.9.76",
  "private": true,
  "description": "Cross-platform multimodal AI assistant with synchronized chat, private files, generated artifacts, memory, intelligence orchestration, subscriptions, and durable credits.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node scripts/production-build-preflight.mjs && node scripts/build-native.mjs && npm run test:client-secrets",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "test:js": "node scripts/check-javascript.mjs",
    "test:a11y": "node scripts/verify-public-accessibility.mjs",
    "test:ui-regression": "node scripts/verify-ui-visual-regression.mjs",
    "test:live-public-destinations": "node scripts/verify-live-public-destinations.mjs",
    "test:public-destination-parser": "node scripts/test-public-destination-parser.mjs",
    "test:native-release-guards": "node scripts/test-native-release-guards.mjs",
    "test:native-push-handoff": "node scripts/verify-native-push-action-handoff.mjs",
    "test:client-secrets": "node scripts/check-client-secrets.mjs",
    "test:browser-controls": "node scripts/verify-browser-control-matrix.mjs",
    "test:intelligence-contract": "python scripts/evaluate_intelligence_benchmark.py benchmarks/intelligence/fixtures/passing_results.v1.json",
    "test": "npm run test:js && npm run test:rename-persistence && npm run test:rename-sync-cursor && npm run test:public-destination-parser && npm run test:native-release-guards && npm run test:native-push-handoff && npm run test:video-result-reveal && npm run test:video-delete && npm run test:briefing-request-timeouts",
    "native:configure": "node scripts/configure-native.mjs",
    "native:assets": "npx --yes @capacitor/assets@3.0.5 generate --iconBackgroundColor \"#0f1419\" --iconBackgroundColorDark \"#0f1419\" --splashBackgroundColor \"#0f1419\" --splashBackgroundColorDark \"#0f1419\"",
    "native:verify": "node scripts/verify-native-release.mjs",
    "store:prepare:android": "node scripts/prepare-store-release.mjs android",
    "store:prepare:ios": "node scripts/prepare-store-release.mjs ios",
    "store:verify:metadata": "node scripts/verify-store-metadata.mjs",
    "store:verify:privacy": "node scripts/verify-native-privacy.mjs source",
    "store:verify:apple-toolchain": "node scripts/verify-apple-toolchain.mjs",
    "store:verify:submission": "node scripts/verify-store-submission-packet.mjs",
    "store:signing:check": "node scripts/verify-mobile-signing.mjs",
    "store:signing:check:android": "node scripts/verify-mobile-signing.mjs --require-android-signing",
    "test:rename-persistence": "node scripts/test-rename-persistence.mjs",
    "test:rename-sync-cursor": "node scripts/test-rename-sync-cursor.mjs",
    "test:video-result-reveal": "node scripts/test-video-result-reveal.mjs",
    "test:video-delete": "node scripts/test-video-delete.mjs",
    "test:briefing-request-timeouts": "node scripts/test-briefing-request-timeouts.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-community/media": "9.1.0",
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.4.3",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/network": "8.0.1",
    "@revenuecat/purchases-capacitor": "13.5.1",
    "@capacitor/push-notifications": "8.0.0",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/cli": "8.4.3",
    "@capacitor/ios": "8.4.3",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "5.0.4"
  }
}
