{
  "name": "ask-crump",
  "version": "5.9.43",
  "private": true,
  "description": "Cross-platform multimodal AI assistant with synchronized chat, private files, generated artifacts, memory, intelligence orchestration, subscriptions, and durable credits.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node scripts/production-build-preflight.mjs && node scripts/build-native.mjs",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "test:js": "node scripts/check-javascript.mjs",
    "test": "npm run test:js",
    "native:configure": "node scripts/configure-native.mjs",
    "native:assets": "npx --yes @capacitor/assets@3.0.5 generate --iconBackgroundColor \"#0f1419\" --iconBackgroundColorDark \"#0f1419\" --splashBackgroundColor \"#0f1419\" --splashBackgroundColorDark \"#0f1419\"",
    "native:verify": "node scripts/verify-native-release.mjs",
    "store:prepare:android": "node scripts/prepare-store-release.mjs android",
    "store:prepare:ios": "node scripts/prepare-store-release.mjs ios",
    "store:verify:metadata": "node scripts/verify-store-metadata.mjs",
    "store:signing:check": "node scripts/verify-mobile-signing.mjs",
    "store:signing:check:android": "node scripts/verify-mobile-signing.mjs --require-android-signing"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor-community/media": "9.1.0",
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.4.2",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/network": "8.0.0",
    "@revenuecat/purchases-capacitor": "13.2.3",
    "@capacitor/push-notifications": "8.0.0",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "esbuild": "0.25.0",
    "typescript": "5.0.4"
  }
}
